//@version=6
// =============================================================================
// TIERED MEAN REVERSION — SESSION & MACRO AWARE  v2
// =============================================================================
// Risk formula: final_risk = base_tier_risk × session_mult × macro_mult × vol_mult
//
// SIGNAL ARCHITECTURE
// ─────────────────────────────────────────────────────────────────────────────
// Core entry: Z-score (Bollinger mean deviation) crosses into extreme territory.
// Three progressive tiers improve average entry as deviation deepens.
// All tiers exit together when Z reverts toward the mean.
//
// TREND DETECTION POINTS
// ─────────────────────────────────────────────────────────────────────────────
// 1. Session overlaps  — London/NY overlap is the primary high-conviction window.
//    Price deviations formed during deep-liquidity hours carry more information.
//    Risk is scaled UP in overlaps, DOWN in thin off-hours.
//    Non-overlapping sessions trade at neutral or slightly reduced risk.
//
// 2. US Macro releases — CPI, NFP, GDP/PCE create sharp Z-score spikes that
//    are often excellent mean-reversion setups AFTER the initial impulse settles.
//    The strategy halts new entries pre-release and during the spike window,
//    then applies a risk boost for post-release reversion trades.
//
// 3. Volume context    — Directional exhaustion bars (high relVol + close
//    near the extreme of the bar's range) confirm the reversal impulse and
//    boost risk. Low-conviction bars reduce risk.
//
// BEST SUITED FOR: crypto 24/7, FX majors, equity index futures (intraday).
// AVOID: single stocks with earnings risk, illiquid instruments.
// =============================================================================

strategy(
     title              = "Tiered Mean Reversion — Session & Macro v2",
     shorttitle         = "TMR v2",
     overlay            = true,
     pyramiding         = 3,
     default_qty_type   = strategy.fixed,
     default_qty_value  = 1,
     initial_capital    = 10000,
     commission_type    = strategy.commission.percent,
     commission_value   = 0.05,
     slippage           = 2,
     calc_on_every_tick = false)

// =============================================================================
// INPUTS
// =============================================================================

grp_mr    = "── Mean Reversion Core"
i_src         = input.source(close,  "Source",                         group=grp_mr)
i_bb_len      = input.int(20,        "Lookback Length",                 group=grp_mr, minval=5, maxval=500)

grp_tiers = "── Entry Tiers  (Z-Score)"
i_t1_z        = input.float(1.5, "Tier 1 Entry Z",                     group=grp_tiers, minval=0.5, maxval=4.9, step=0.1)
i_t2_z        = input.float(2.0, "Tier 2 Entry Z",                     group=grp_tiers, minval=0.5, maxval=4.9, step=0.1)
i_t3_z        = input.float(2.5, "Tier 3 Entry Z",                     group=grp_tiers, minval=0.5, maxval=4.9, step=0.1)
i_stop_z      = input.float(4.0, "Stop-Out Z",                         group=grp_tiers, minval=2.5, maxval=8.0, step=0.25)
i_exit_z      = input.float(0.1, "Exit Z (near mean)",                 group=grp_tiers, minval=-0.5, maxval=1.5, step=0.05,
     tooltip="Longs exit when Z crosses ABOVE  -ExitZ.\nShorts exit when Z crosses BELOW +ExitZ.")

grp_dir   = "── Direction"
i_allow_long  = input.bool(true,  "Allow Longs",                       group=grp_dir)
i_allow_short = input.bool(true,  "Allow Shorts",                      group=grp_dir)

grp_risk  = "── Base Risk Per Tier"
i_t1_risk     = input.float(1.0, "Tier 1 Base Risk %",                 group=grp_risk, minval=0.1, maxval=10.0, step=0.1)
i_t2_risk     = input.float(1.5, "Tier 2 Base Risk %",                 group=grp_risk, minval=0.1, maxval=10.0, step=0.1)
i_t3_risk     = input.float(2.0, "Tier 3 Base Risk %",                 group=grp_risk, minval=0.1, maxval=10.0, step=0.1)
i_max_bars    = input.int(50,    "Max Bars in Trade  (0 = off)",        group=grp_risk, minval=0)

// ── Session weighting ─────────────────────────────────────────────────────────
grp_sess  = "── Session Risk Weighting"
i_use_sess    = input.bool(true,   "Enable Session Weighting",          group=grp_sess,
     tooltip="Scales entry risk by the liquidity of the session.\nHighest in London/NY overlap; lowest off-hours.")
i_skip_offh   = input.bool(true,   "Block Entries in Off-Hours",        group=grp_sess)
i_m_ln        = input.float(1.25,  "London / NY Overlap ×",            group=grp_sess, minval=0.0, maxval=3.0, step=0.05)
i_m_al        = input.float(0.90,  "Asia / London Overlap ×",          group=grp_sess, minval=0.0, maxval=3.0, step=0.05)
i_m_lo        = input.float(1.00,  "London Only ×",                    group=grp_sess, minval=0.0, maxval=3.0, step=0.05)
i_m_ny        = input.float(1.00,  "New York Only ×",                  group=grp_sess, minval=0.0, maxval=3.0, step=0.05)
i_m_as        = input.float(0.75,  "Tokyo / Asia Only ×",              group=grp_sess, minval=0.0, maxval=3.0, step=0.05)
i_m_oh        = input.float(0.50,  "Off-Hours ×",                      group=grp_sess, minval=0.0, maxval=3.0, step=0.05)

// ── US Macro Calendar ─────────────────────────────────────────────────────────
grp_mac   = "── US Macro Calendar Guard"
i_use_mac     = input.bool(true,   "Enable Macro Calendar Guard",       group=grp_mac,
     tooltip="Approximates NFP / CPI / GDP release days.\nNot guaranteed exact — acts as a systematic risk buffer.")
i_mac_nfp     = input.bool(true,   "Guard  NFP   (1st Friday)",        group=grp_mac)
i_mac_cpi     = input.bool(true,   "Guard  CPI/PPI  (2nd–3rd Tue/Wed)", group=grp_mac)
i_mac_gdp     = input.bool(true,   "Guard  GDP/PCE  (last Thursday)",  group=grp_mac)
i_pre_halt    = input.bool(true,   "Halt  Pre-Release  (30 min)",       group=grp_mac)
i_dur_halt    = input.bool(true,   "Halt  During Release  (60 min)",    group=grp_mac)
i_close_pre   = input.bool(false,  "Close Positions Pre-Release",       group=grp_mac,
     tooltip="Force-closes open positions entering the pre-release halt window.")
i_post_boost  = input.bool(true,   "Post-Release Reversion Boost",     group=grp_mac,
     tooltip="Mean-reversion after a macro spike is often high-quality.\nBoosts risk for ~2 h after release.")
i_post_mult   = input.float(1.25,  "Post-Release Risk ×",              group=grp_mac, minval=0.5, maxval=3.0, step=0.05)

// ── Volume Risk Adjustment ────────────────────────────────────────────────────
grp_vol   = "── Volume Risk Adjustment"
i_use_vol     = input.bool(true,   "Enable Volume Risk Adjustment",     group=grp_vol,
     tooltip="Directional exhaustion = high relVol + close near the bar's extreme.\nConfirms the reversal impulse; adjusts risk accordingly.")
i_vol_len     = input.int(20,      "Volume SMA Length",                 group=grp_vol, minval=2)
i_vol_th      = input.float(1.20,  "High-Volume Threshold  (× avg)",   group=grp_vol, minval=0.5, step=0.05)
i_cl_loc_th   = input.float(0.65,  "Directional Close Location",        group=grp_vol, minval=0.5, maxval=1.0, step=0.05,
     tooltip="Long confirm: close ≥ top X% of bar range (selling climax).\nShort confirm: close ≤ bottom X% (buying climax).")
i_vol_boost   = input.float(1.20,  "Confirmed Volume ×",               group=grp_vol, minval=1.0, maxval=3.0, step=0.05)
i_vol_penalty = input.float(0.70,  "Low Volume ×",                     group=grp_vol, minval=0.1, maxval=1.0, step=0.05)

// ── ADX Regime Filter ────────────────────────────────────────────────────────
grp_adx   = "── ADX Regime Filter"
i_use_adx     = input.bool(true,   "Use ADX Range Filter",              group=grp_adx)
i_adx_len     = input.int(14,      "ADX Length",                        group=grp_adx, minval=2)
i_adx_max     = input.float(25.0,  "Max ADX  (market is ranging)",     group=grp_adx, minval=5.0, maxval=60.0, step=1.0)

// ── HTF Trend Bias ───────────────────────────────────────────────────────────
grp_htf   = "── HTF Trend Bias"
i_use_htf     = input.bool(true,   "HTF Trend Bias Filter",             group=grp_htf,
     tooltip="Only fade dips in HTF uptrend (longs).\nOnly fade rips in HTF downtrend (shorts).")
i_htf_tf      = input.timeframe("D", "HTF Timeframe",                  group=grp_htf)
i_htf_len     = input.int(50,      "HTF EMA Length",                   group=grp_htf, minval=5)

// ── Drawdown Governor ─────────────────────────────────────────────────────────
grp_dd    = "── Drawdown Governor"
i_use_dd      = input.bool(false,  "Pause on Drawdown",                 group=grp_dd)
i_dd_halt     = input.float(15.0,  "Halt Threshold (%)",                group=grp_dd, minval=1.0, step=0.5)

// ── Visuals ───────────────────────────────────────────────────────────────────
grp_vis   = "── Visuals"
i_show_bands  = input.bool(true,   "Show Tier Bands",                   group=grp_vis)
i_show_basis  = input.bool(true,   "Show Mean Line",                    group=grp_vis)
i_show_sigs   = input.bool(true,   "Show Entry Signals",                group=grp_vis)
i_show_levels = input.bool(true,   "Show Active Stop / Target Lines",   group=grp_vis)
i_show_sess   = input.bool(true,   "Show Session Background",           group=grp_vis)
i_show_macro  = input.bool(true,   "Show Macro Event Background",       group=grp_vis)

// =============================================================================
// CORE CALCULATIONS
// =============================================================================

// ── Equity & drawdown ────────────────────────────────────────────────────────
realized_eq  = strategy.initial_capital + strategy.netprofit
var float eq_peak = strategy.initial_capital
eq_peak     := math.max(eq_peak, realized_eq)
dd_pct       = eq_peak > 0 ? (eq_peak - realized_eq) / eq_peak * 100.0 : 0.0
dd_halted    = i_use_dd and dd_pct >= i_dd_halt

// ── Z-score (Bollinger mean deviation) ───────────────────────────────────────
bb_mean  = ta.sma(i_src, i_bb_len)
bb_std   = ta.stdev(i_src, i_bb_len)
z        = bb_std > 0 ? (i_src - bb_mean) / bb_std : 0.0

lvl_t1u  = bb_mean + i_t1_z  * bb_std
lvl_t2u  = bb_mean + i_t2_z  * bb_std
lvl_t3u  = bb_mean + i_t3_z  * bb_std
lvl_stu  = bb_mean + i_stop_z * bb_std
lvl_t1l  = bb_mean - i_t1_z  * bb_std
lvl_t2l  = bb_mean - i_t2_z  * bb_std
lvl_t3l  = bb_mean - i_t3_z  * bb_std
lvl_stl  = bb_mean - i_stop_z * bb_std

// ── ADX regime filter ────────────────────────────────────────────────────────
[_dip, _dim, adx] = ta.dmi(i_adx_len, i_adx_len)
is_ranging = not i_use_adx or adx <= i_adx_max

// ── HTF trend bias ───────────────────────────────────────────────────────────
htf_c   = request.security(syminfo.tickerid, i_htf_tf, close,
     barmerge.gaps_off, barmerge.lookahead_off)
htf_ema = request.security(syminfo.tickerid, i_htf_tf, ta.ema(close, i_htf_len),
     barmerge.gaps_off, barmerge.lookahead_off)
htf_up  = htf_c > htf_ema
htf_dn  = htf_c < htf_ema
ok_long  = i_allow_long  and (not i_use_htf or htf_up)
ok_short = i_allow_short and (not i_use_htf or htf_dn)

// =============================================================================
// SESSION DETECTION & MULTIPLIER
// =============================================================================
// Clock-time sessions using TZ-database names (DST-aware).
// On daily+ charts every flag is forced true and multiplier = 1.0 (no filter).

is_intraday = timeframe.isintraday

in_tokyo  = is_intraday ? not na(time(timeframe.period, "0900-1530", "Asia/Tokyo"))        : true
in_london = is_intraday ? not na(time(timeframe.period, "0800-1700", "Europe/London"))     : true
in_ny     = is_intraday ? not na(time(timeframe.period, "0930-1600", "America/New_York"))  : true

// Overlapping sessions — the strongest liquidity / trend confirmation windows
overlap_ln = in_london and in_ny    // ~13:30–17:00 UTC  — most liquid globally
overlap_al = in_tokyo  and in_london // ~08:00–09:30 UTC — Asia handoff

in_any_session = in_tokyo or in_london or in_ny
ok_sess_entry  = not is_intraday or not i_skip_offh or in_any_session

sess_mult =
     not i_use_sess or not is_intraday ? 1.0  :
     overlap_ln                        ? i_m_ln :
     overlap_al                        ? i_m_al :
     in_london                         ? i_m_lo :
     in_ny                             ? i_m_ny :
     in_tokyo                          ? i_m_as :
     i_m_oh

sess_label =
     not is_intraday ? "DAILY+" :
     overlap_ln      ? "OVL L/NY" :
     overlap_al      ? "OVL A/L"  :
     in_london       ? "LONDON"   :
     in_ny           ? "NEW YORK" :
     in_tokyo        ? "TOKYO"    :
     "OFF-HRS"

sess_col =
     overlap_ln                    ? color.lime   :
     overlap_al or in_london or in_ny ? color.aqua :
     in_tokyo                      ? color.blue   :
     color.gray

// =============================================================================
// US MACRO CALENDAR APPROXIMATION
// =============================================================================
// Approximate schedules based on typical release patterns:
//   NFP    : 1st Friday of each month             (days 1–7,   Friday)
//   CPI/PPI: 2nd–3rd week, Tuesday or Wednesday   (days 8–21,  Tue/Wed)
//   GDP/PCE: Last week,    Thursday                (days 22+,   Thursday)
//
// Time windows anchored to 08:30 ET (when data typically hits the tape).
// For daily+ charts the entire macro day receives a mild risk reduction.

_dow = dayofweek
_dom = dayofmonth

_raw_nfp = _dow == dayofweek.friday   and _dom <= 7
_raw_cpi = (_dow == dayofweek.tuesday or _dow == dayofweek.wednesday) and _dom >= 8  and _dom <= 21
_raw_gdp = _dow == dayofweek.thursday and _dom >= 22

is_nfp_day = i_use_mac and i_mac_nfp and _raw_nfp
is_cpi_day = i_use_mac and i_mac_cpi and _raw_cpi
is_gdp_day = i_use_mac and i_mac_gdp and _raw_gdp
is_macro_day = is_nfp_day or is_cpi_day or is_gdp_day

// Intraday release windows (only meaningful on intraday charts)
pre_release  = is_macro_day and i_pre_halt   and is_intraday and not na(time(timeframe.period, "0800-0830", "America/New_York"))
at_release   = is_macro_day and i_dur_halt   and is_intraday and not na(time(timeframe.period, "0830-0930", "America/New_York"))
post_release = is_macro_day and i_post_boost and is_intraday and not na(time(timeframe.period, "0930-1200", "America/New_York"))

// On daily+ charts: mild risk reduction for the whole macro day
daily_macro  = not is_intraday and is_macro_day

macro_halt         = pre_release or at_release
macro_boost_active = post_release

macro_mult =
     not i_use_mac      ? 1.0 :
     macro_halt         ? 0.0          : // gate: no new entries
     macro_boost_active ? i_post_mult  : // post-release reversion boost
     daily_macro        ? 0.80         : // daily chart: gentle dampener
     1.0

macro_label =
     macro_halt         ? "HALTED"   :
     macro_boost_active ? "POST-REL" :
     is_nfp_day         ? "NFP DAY"  :
     is_cpi_day         ? "CPI DAY"  :
     is_gdp_day         ? "GDP DAY"  :
     "NORMAL"

macro_label_col =
     macro_halt         ? color.red    :
     macro_boost_active ? color.lime   :
     is_macro_day       ? color.orange :
     color.gray

// =============================================================================
// VOLUME RISK ADJUSTMENT
// =============================================================================
// Directional exhaustion logic:
//   Long confirm  = high volume + close near BAR HIGH  → selling climax / reversal
//   Short confirm = high volume + close near BAR LOW   → buying climax / reversal
// This aligns volume confirmation with the TYPE of mean-reversion we're doing.

vol_sma   = ta.sma(volume, i_vol_len)
rel_vol   = vol_sma > 0 ? volume / vol_sma : 1.0
bar_rng   = math.max(high - low, syminfo.mintick)
close_loc = (close - low) / bar_rng                 // 1.0 = closed at high

vol_high        = rel_vol >= i_vol_th
vol_conf_long   = vol_high and close_loc >= i_cl_loc_th          // exhaustion of sellers
vol_conf_short  = vol_high and close_loc <= (1.0 - i_cl_loc_th)  // exhaustion of buyers

vol_mult_long  =
     not i_use_vol  ? 1.0         :
     vol_conf_long  ? i_vol_boost :
     vol_high       ? 1.0         :
     i_vol_penalty

vol_mult_short =
     not i_use_vol  ? 1.0         :
     vol_conf_short ? i_vol_boost :
     vol_high       ? 1.0         :
     i_vol_penalty

// =============================================================================
// COMPOSITED FINAL RISK MULTIPLIER
// =============================================================================
// final_risk = base_tier_risk × sess_mult × macro_mult × vol_mult
//
// Examples at defaults:
//   Overlap L/NY + vol confirmed + normal day  → 1.25 × 1.0 × 1.20 = 1.50×
//   Off-hours   + low volume    + macro halt   → 0.50 × 0.0 × 0.70 = 0.00 (gated)
//   Asia-only   + no vol filter + post-release → 0.75 × 1.25 × 1.0 = 0.94×

macro_gated   = macro_mult == 0.0
ok_entry      = is_ranging and ok_sess_entry and not macro_gated and not dd_halted

final_mult_l  = sess_mult * macro_mult * vol_mult_long
final_mult_s  = sess_mult * macro_mult * vol_mult_short

// =============================================================================
// POSITION STATE
// =============================================================================

in_long  = strategy.position_size > 0
in_short = strategy.position_size < 0
is_flat  = strategy.position_size == 0

var int long_tiers  = 0
var int short_tiers = 0
if is_flat
    long_tiers  := 0
    short_tiers := 0

var int bars_held = 0
if is_flat
    bars_held := 0
else
    bars_held += 1

// =============================================================================
// RISK SIZING
// =============================================================================
// qty = (equity × adjusted_risk%) / stop_distance
// Stop distance anchored to the Z-stop price level at entry bar,
// so qty inherently scales with current volatility (bb_std).

f_qty(base_risk, stop_px, risk_mult) =>
    eq       = math.max(realized_eq, 1.0)
    adj_risk = base_risk * risk_mult
    risk_amt = eq * adj_risk / 100.0
    stop_d   = math.abs(close - stop_px)
    qty      = stop_d > 0 ? risk_amt / stop_d : 0.0
    math.max(qty, 0.0)

long_stop_px  = lvl_stl
short_stop_px = lvl_stu

l1_qty = f_qty(i_t1_risk, long_stop_px,  final_mult_l)
l2_qty = f_qty(i_t2_risk, long_stop_px,  final_mult_l)
l3_qty = f_qty(i_t3_risk, long_stop_px,  final_mult_l)
s1_qty = f_qty(i_t1_risk, short_stop_px, final_mult_s)
s2_qty = f_qty(i_t2_risk, short_stop_px, final_mult_s)
s3_qty = f_qty(i_t3_risk, short_stop_px, final_mult_s)

// =============================================================================
// ENTRY SIGNALS
// =============================================================================
// Each tier requires a NEW crossover at its Z threshold — price must first
// retreat past the level before it can re-trigger, preventing duplicate fills.

// ── Long tiers: fade the statistical dip ──────────────────────────────────────
sig_l1 = ok_entry and ok_long  and ta.crossunder(z, -i_t1_z) and is_flat
sig_l2 = ok_entry and ok_long  and ta.crossunder(z, -i_t2_z) and in_long  and long_tiers  == 1
sig_l3 = ok_entry and ok_long  and ta.crossunder(z, -i_t3_z) and in_long  and long_tiers  == 2

// ── Short tiers: fade the statistical rip ────────────────────────────────────
sig_s1 = ok_entry and ok_short and ta.crossover( z,  i_t1_z) and is_flat
sig_s2 = ok_entry and ok_short and ta.crossover( z,  i_t2_z) and in_short and short_tiers == 1
sig_s3 = ok_entry and ok_short and ta.crossover( z,  i_t3_z) and in_short and short_tiers == 2

// =============================================================================
// ENTRIES
// =============================================================================
// Entry comment encodes session and volume state for trade-log review.

_vol_tag_l = vol_conf_long  ? " VOL+" : vol_high ? " VOL" : ""
_vol_tag_s = vol_conf_short ? " VOL+" : vol_high ? " VOL" : ""

if sig_l1 and l1_qty > 0
    strategy.entry("L1", strategy.long,  qty=l1_qty, comment="L1 " + sess_label + _vol_tag_l)
    long_tiers := 1

if sig_l2 and l2_qty > 0
    strategy.entry("L2", strategy.long,  qty=l2_qty, comment="L2 " + sess_label + _vol_tag_l)
    long_tiers := 2

if sig_l3 and l3_qty > 0
    strategy.entry("L3", strategy.long,  qty=l3_qty, comment="L3 " + sess_label + _vol_tag_l)
    long_tiers := 3

if sig_s1 and s1_qty > 0
    strategy.entry("S1", strategy.short, qty=s1_qty, comment="S1 " + sess_label + _vol_tag_s)
    short_tiers := 1

if sig_s2 and s2_qty > 0
    strategy.entry("S2", strategy.short, qty=s2_qty, comment="S2 " + sess_label + _vol_tag_s)
    short_tiers := 2

if sig_s3 and s3_qty > 0
    strategy.entry("S3", strategy.short, qty=s3_qty, comment="S3 " + sess_label + _vol_tag_s)
    short_tiers := 3

// =============================================================================
// EXITS
// =============================================================================
// Four exit paths:
//   1. Mean Revert Exit  — Z reverts toward zero  (primary profit target)
//   2. Z-Score Stop-Out  — price extended past stop_z  (mean has failed)
//   3. Time Stop         — position open too long  (opportunity cost)
//   4. Pre-Macro Close   — optional force-close before scheduled release

long_mean_exit  = in_long  and ta.crossover( z, -i_exit_z)
short_mean_exit = in_short and ta.crossunder(z,  i_exit_z)
long_z_stop     = in_long  and z <= -i_stop_z
short_z_stop    = in_short and z >=  i_stop_z
time_stop       = (i_max_bars > 0) and bars_held >= i_max_bars
macro_close     = i_use_mac and i_close_pre and pre_release and (in_long or in_short)

// Pre-macro protective close (runs before normal exits so comment is accurate)
if macro_close
    strategy.close_all(comment="Pre-Macro Close")
    long_tiers  := 0
    short_tiers := 0

if in_long
    l_rsn = long_z_stop ? "Z-Stop Long"  : time_stop ? "Time Stop" : "Mean Revert Long"
    if long_mean_exit or long_z_stop or time_stop
        strategy.close_all(comment=l_rsn)
        long_tiers := 0

if in_short
    s_rsn = short_z_stop ? "Z-Stop Short" : time_stop ? "Time Stop" : "Mean Revert Short"
    if short_mean_exit or short_z_stop or time_stop
        strategy.close_all(comment=s_rsn)
        short_tiers := 0

// =============================================================================
// VISUALS
// =============================================================================

// ── Session backgrounds (subtle, layered) ─────────────────────────────────────
bgcolor(i_show_sess and is_intraday and overlap_ln ? color.new(color.green,  94) : na, title="Session: L/NY Overlap")
bgcolor(i_show_sess and is_intraday and overlap_al ? color.new(color.teal,   94) : na, title="Session: A/L Overlap")
bgcolor(i_show_sess and is_intraday and in_london and not overlap_ln ? color.new(color.blue, 97) : na, title="Session: London")
bgcolor(i_show_sess and is_intraday and in_ny     and not overlap_ln ? color.new(color.blue, 97) : na, title="Session: New York")
bgcolor(i_show_sess and is_intraday and in_tokyo  and not overlap_al ? color.new(color.purple, 97) : na, title="Session: Tokyo")

// ── Macro event backgrounds ───────────────────────────────────────────────────
bgcolor(i_show_macro and macro_halt         ? color.new(color.red,    88) : na, title="Macro: Release Halt")
bgcolor(i_show_macro and macro_boost_active ? color.new(color.yellow, 93) : na, title="Macro: Post-Release Boost")
bgcolor(i_show_macro and is_macro_day and not macro_halt and not macro_boost_active
     ? color.new(color.orange, 96) : na, title="Macro: Event Day")

// ── Regime backgrounds ────────────────────────────────────────────────────────
bgcolor(i_use_adx and not is_ranging ? color.new(color.purple, 93) : na, title="Trending (ADX filtered)")
bgcolor(dd_halted                    ? color.new(color.red,    90) : na, title="DD Halt Active")

// ── Mean line ─────────────────────────────────────────────────────────────────
plot(i_show_basis ? bb_mean : na, "Mean", color.new(color.silver, 20), 1)

// ── Tier bands ────────────────────────────────────────────────────────────────
p_t1u = plot(i_show_bands ? lvl_t1u : na, "T1 Upper", color.new(color.blue,   50), 1)
p_t2u = plot(i_show_bands ? lvl_t2u : na, "T2 Upper", color.new(color.orange, 30), 1)
p_t3u = plot(i_show_bands ? lvl_t3u : na, "T3 Upper", color.new(color.red,    10), 1)
p_t1l = plot(i_show_bands ? lvl_t1l : na, "T1 Lower", color.new(color.blue,   50), 1)
p_t2l = plot(i_show_bands ? lvl_t2l : na, "T2 Lower", color.new(color.orange, 30), 1)
p_t3l = plot(i_show_bands ? lvl_t3l : na, "T3 Lower", color.new(color.red,    10), 1)

fill(p_t1u, p_t2u, color.new(color.blue,   92), title="T1→T2 Upper Zone")
fill(p_t2u, p_t3u, color.new(color.orange, 87), title="T2→T3 Upper Zone")
fill(p_t1l, p_t2l, color.new(color.blue,   92), title="T1→T2 Lower Zone")
fill(p_t2l, p_t3l, color.new(color.orange, 87), title="T2→T3 Lower Zone")

// ── Active trade levels ───────────────────────────────────────────────────────
plot(i_show_levels and in_long  ? long_stop_px  : na, "Long Z-Stop",      color.new(color.red,  0), 1, plot.style_linebr)
plot(i_show_levels and in_long  ? bb_mean       : na, "Long Mean Target",  color.new(color.lime, 0), 1, plot.style_linebr)
plot(i_show_levels and in_short ? short_stop_px : na, "Short Z-Stop",     color.new(color.red,  0), 1, plot.style_linebr)
plot(i_show_levels and in_short ? bb_mean       : na, "Short Mean Target", color.new(color.lime, 0), 1, plot.style_linebr)

// ── Entry signals — size scales with tier depth ───────────────────────────────
plotshape(i_show_sigs and sig_l1, "L1", shape.triangleup,   location.belowbar, color.new(color.lime,   0), size=size.tiny,   text="L1")
plotshape(i_show_sigs and sig_l2, "L2", shape.triangleup,   location.belowbar, color.new(color.teal,   0), size=size.small,  text="L2")
plotshape(i_show_sigs and sig_l3, "L3", shape.triangleup,   location.belowbar, color.new(color.aqua,   0), size=size.normal, text="L3")
plotshape(i_show_sigs and sig_s1, "S1", shape.triangledown, location.abovebar, color.new(color.red,    0), size=size.tiny,   text="S1")
plotshape(i_show_sigs and sig_s2, "S2", shape.triangledown, location.abovebar, color.new(color.orange, 0), size=size.small,  text="S2")
plotshape(i_show_sigs and sig_s3, "S3", shape.triangledown, location.abovebar, color.new(color.maroon, 0), size=size.normal, text="S3")

// =============================================================================
// INFO TABLE
// =============================================================================

var table t = table.new(position.top_right, 2, 16,
     bgcolor=color.new(color.black, 70),
     border_color=color.new(color.gray, 60),
     border_width=1)

if barstate.islast
    // ── Header ────────────────────────────────────────────────────────────────
    table.cell(t, 0, 0, "TMR  Session & Macro  v2", text_color=color.white,  text_size=size.small, bgcolor=color.new(color.navy, 30))
    table.cell(t, 1, 0, syminfo.ticker,              text_color=color.yellow, text_size=size.small, bgcolor=color.new(color.navy, 30))

    // ── Equity & Drawdown ─────────────────────────────────────────────────────
    table.cell(t, 0, 1, "Equity",       text_color=color.gray,  text_size=size.tiny)
    table.cell(t, 1, 1, "$" + str.tostring(realized_eq, "#,###.##"), text_color=color.white, text_size=size.tiny)

    dd_col = dd_pct > i_dd_halt * 0.75 ? color.red : dd_pct > i_dd_halt * 0.5 ? color.orange : color.white
    table.cell(t, 0, 2, "DD %",         text_color=color.gray,  text_size=size.tiny)
    table.cell(t, 1, 2, str.tostring(dd_pct, "#.##") + "%", text_color=dd_col, text_size=size.tiny)

    // ── Z-Score ───────────────────────────────────────────────────────────────
    az    = math.abs(z)
    z_col = az >= i_stop_z ? color.red : az >= i_t3_z ? color.orange : az >= i_t2_z ? color.yellow : az >= i_t1_z ? color.lime : color.white
    table.cell(t, 0, 3, "Z-Score",      text_color=color.gray,  text_size=size.tiny)
    table.cell(t, 1, 3, str.tostring(z, "#.##"), text_color=z_col, text_size=size.tiny)

    // ── ADX & Regime ──────────────────────────────────────────────────────────
    table.cell(t, 0, 4, "ADX / Regime", text_color=color.gray,  text_size=size.tiny)
    table.cell(t, 1, 4, str.tostring(adx, "#.#") + "  " + (is_ranging ? "RANGE" : "TREND"),
         text_color=is_ranging ? color.lime : color.red, text_size=size.tiny)

    // ── HTF Bias ──────────────────────────────────────────────────────────────
    htf_txt = htf_up ? "BULL" : htf_dn ? "BEAR" : "NEUTRAL"
    htf_col = htf_up ? color.lime : htf_dn ? color.red : color.gray
    table.cell(t, 0, 5, "HTF Bias",     text_color=color.gray,  text_size=size.tiny)
    table.cell(t, 1, 5, htf_txt,        text_color=htf_col,     text_size=size.tiny)

    // ── Session ───────────────────────────────────────────────────────────────
    table.cell(t, 0, 6, "Session",      text_color=color.gray,  text_size=size.tiny)
    table.cell(t, 1, 6, sess_label,     text_color=sess_col,    text_size=size.tiny)

    table.cell(t, 0, 7, "Session ×",    text_color=color.gray,  text_size=size.tiny)
    table.cell(t, 1, 7, str.tostring(sess_mult, "#.##") + "×",
         text_color=sess_mult >= 1.0 ? color.lime : color.orange, text_size=size.tiny)

    // ── Macro ─────────────────────────────────────────────────────────────────
    table.cell(t, 0, 8, "Macro",        text_color=color.gray,        text_size=size.tiny)
    table.cell(t, 1, 8, macro_label,    text_color=macro_label_col,   text_size=size.tiny)

    table.cell(t, 0, 9, "Macro ×",      text_color=color.gray,  text_size=size.tiny)
    mac_mult_col = macro_mult == 0.0 ? color.red : macro_mult > 1.0 ? color.lime : macro_mult < 1.0 ? color.orange : color.white
    table.cell(t, 1, 9, str.tostring(macro_mult, "#.##") + "×", text_color=mac_mult_col, text_size=size.tiny)

    // ── Volume ────────────────────────────────────────────────────────────────
    table.cell(t, 0, 10, "Rel Vol",     text_color=color.gray,  text_size=size.tiny)
    table.cell(t, 1, 10, str.tostring(rel_vol, "#.##") + "×",
         text_color=vol_high ? color.lime : color.gray, text_size=size.tiny)

    // Show directional vol mult based on current side (or long side if flat)
    _side_vol_m = in_short ? vol_mult_short : vol_mult_long
    table.cell(t, 0, 11, "Vol ×",       text_color=color.gray,  text_size=size.tiny)
    table.cell(t, 1, 11, str.tostring(_side_vol_m, "#.##") + "×",
         text_color=_side_vol_m > 1.0 ? color.lime : _side_vol_m < 1.0 ? color.orange : color.white, text_size=size.tiny)

    // ── Effective final multiplier ─────────────────────────────────────────────
    _eff = in_short ? final_mult_s : final_mult_l
    table.cell(t, 0, 12, "Final ×",     text_color=color.gray,  text_size=size.tiny)
    table.cell(t, 1, 12, str.tostring(_eff, "#.##") + "×",
         text_color=_eff > 1.0 ? color.lime : _eff == 0.0 ? color.red : color.orange, text_size=size.tiny)

    // ── Position ──────────────────────────────────────────────────────────────
    pos_txt = in_long  ? "LONG  ×" + str.tostring(long_tiers)  :
              in_short ? "SHORT ×" + str.tostring(short_tiers) : "FLAT"
    pos_col = in_long ? color.lime : in_short ? color.red : color.gray
    table.cell(t, 0, 13, "Position",    text_color=color.gray,  text_size=size.tiny)
    table.cell(t, 1, 13, pos_txt,       text_color=pos_col,     text_size=size.tiny)

    table.cell(t, 0, 14, "Bars Held",   text_color=color.gray,  text_size=size.tiny)
    table.cell(t, 1, 14, str.tostring(bars_held), text_color=color.white, text_size=size.tiny)

    // ── Status ────────────────────────────────────────────────────────────────
    stat_txt = dd_halted ? "DD HALT" : macro_gated ? "MAC GATE" : not ok_sess_entry ? "OFF-HRS" : not is_ranging ? "TRENDING" : "ACTIVE"
    stat_col = (dd_halted or macro_gated) ? color.red : not ok_sess_entry or not is_ranging ? color.orange : color.lime
    table.cell(t, 0, 15, "Status",      text_color=color.gray,  text_size=size.tiny)
    table.cell(t, 1, 15, stat_txt,      text_color=stat_col,    text_size=size.tiny)
